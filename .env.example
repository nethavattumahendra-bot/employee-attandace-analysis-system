# Database Configuration
# Engine can be 'mysql' or 'sqlite'
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=employee_attendance_db

# Fallback to SQLite if MySQL is unavailable (True/False)
ENABLE_DB_FALLBACK=True
SQLITE_DB_PATH=data/attendance.db

# Application Configuration
APP_ENV=development
DEBUG=True
PORT=5000
SECRET_KEY=dev-secret-key-employee-attendance-2026
